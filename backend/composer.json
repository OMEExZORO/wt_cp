{
    "name": "diagnocare/backend",
    "description": "DiagnoCare PHP REST API for Meghnad Diagnostic Centre",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "ext-openssl": "*",
        "ext-mbstring": "*",
        "ext-fileinfo": "*",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "migrate": "php bin/migrate.php",
        "seed:base": "php bin/seed.php base",
        "seed:dev": "php bin/seed.php dev",
        "seed:demo": "php bin/seed.php demo",
        "serve": "php -S localhost:8000 -t public"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    }
}
