{
  "name": "diagnocare",
  "version": "0.1.0",
  "private": true,
  "description": "DiagnoCare: clinic website and patient portal for Meghnad Diagnostic Centre",
  "scripts": {
    "setup": "npm install && npm install --prefix frontend && npm install --prefix services/alerts && composer install --working-dir=backend",
    "dev": "concurrently -n api,web,alerts -c blue,magenta,yellow \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:alerts\"",
    "dev:api": "php -S localhost:8000 -t backend/public",
    "dev:web": "npm run dev --prefix frontend",
    "dev:alerts": "npm run dev --prefix services/alerts",
    "build": "npm run build --prefix frontend",
    "test": "npm run test:api && npm run test:web",
    "test:api": "php backend/vendor/bin/phpunit -c backend/phpunit.xml",
    "test:web": "npm run test --prefix frontend",
    "migrate": "php backend/bin/migrate.php",
    "migrate:status": "php backend/bin/migrate.php --status",
    "seed": "php backend/bin/seed.php base",
    "seed:dev": "php backend/bin/seed.php dev",
    "seed:demo": "php backend/bin/seed.php demo",
    "seed:purge-demo": "php backend/bin/seed.php purge-demo",
    "db:counts": "php backend/bin/seed.php counts",
    "storage:setup": "php backend/bin/storage-setup.php"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
